    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.005" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001" />
    </inertial>
  </link>

  <joint name="turtlebot3_waffle_piimu_joint" type="fixed">
    <parent link="turtlebot3_waffle_pibase_link"/>
    <child link="turtlebot3_waffle_piimu_link"/>
    <origin xyz="0.0 0 0.068" rpy="0 0 0"/>
  </joint>

  <link name="turtlebot3_waffle_piimu_link"/>

  <joint name="turtlebot3_waffle_piscan_joint" type="fixed">
    <parent link="turtlebot3_waffle_pibase_link"/>
    <child link="turtlebot3_waffle_pibase_scan"/>
    <origin xyz="-0.024 0 0.122" rpy="0 0 0"/>
  </joint>

  <link name="turtlebot3_waffle_pibase_scan">
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="ladar.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
