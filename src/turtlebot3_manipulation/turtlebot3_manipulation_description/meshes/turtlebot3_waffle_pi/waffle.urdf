  <joint name="turtlebot3_waffle_picamera_rgb_joint" type="fixed">
    <parent link="turtlebot3_waffle_picamera_link"/>
    <child link="turtlebot3_waffle_picamera_rgb_frame"/>
    <origin xyz="0.003 0.011 0.009" rpy="0 0 0"/>
  </joint>

  <link name="turtlebot3_waffle_picamera_rgb_frame"/>

  <joint name="turtlebot3_waffle_picamera_rgb_optical_joint" type="fixed">
    <parent link="turtlebot3_waffle_picamera_rgb_frame"/>
    <child link="turtlebot3_waffle_picamera_rgb_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57 0 -1.57"/>
