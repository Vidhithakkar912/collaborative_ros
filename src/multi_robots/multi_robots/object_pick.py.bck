    #         return False

    #     result = result_future.result().result

    #     self.get_logger().info(
    #         f"Gripper finished: "
    #         f"position={result.position:.4f}, "
    #         f"effort={result.effort:.4f}, "
    #         f"stalled={result.stalled}, "
    #         f"reached_goal={result.reached_goal}"
    #     )

    #     return bool(result.reached_goal)
    def open_gripper(self) -> bool:
            return self.send_gripper_command(
            position=GRIPPER_OPEN_POSITION,
            max_effort=GRIPPER_MAX_EFFORT
        )


    def close_gripper(self) -> bool:
        return self.send_gripper_command(
            position=GRIPPER_CLOSE_POSITION,
            max_effort=GRIPPER_MAX_EFFORT
        )
    def _rgb_callback(self, msg: Image):
        self.get_logger().info("rgb image is received")
        try:
            cv_img = self._bridge.imgmsg_to_cv2(msg, desired_encoding="bgr8")
            self.latest_rgb = cv_img.copy()
        except CvBridgeError as e:
            self.get_logger().error(f"cv_bridge error: {e}")
            return

        self.rgb_h, self.rgb_w = cv_img.shape[:2]

        try:
            detections = detect_rectangles_yolo(self.model, cv_img)
        except Exception as e:
            self.get_logger().error(f"detect_rectangles failed: {e}")
            return

        for det in detections:
            xmin, xmax, ymin, ymax = det["bbox"]
            cls_name = det["class"]
            conf = det["confidence"]

            cv2.rectangle(cv_img, (xmin, ymin), (xmax, ymax), (0, 255, 0), 2)
            cv2.putText(
                cv_img, f"{cls_name} {conf:.2f}", (xmin, ymin - 10),
                cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)

        # try:
        #     annotated_msg = self._bridge.cv2_to_imgmsg(cv_img, encoding="bgr8")
        #     annotated_msg.header = msg.header
        #     self._debug_img_pub.publish(annotated_msg)
        # except CvBridgeError as e:
        #     self.get_logger().error(f"Publish debug image failed: {e}")

        
        with self._mtx:
            self._detections = detections if len(detections) > 0 else []

    def _depth_img_callback(self, msg: Image):
        self.get_logger().info("depth callback is received")
        try:
            cv_depth = self._bridge.imgmsg_to_cv2(
                msg, desired_encoding="passthrough")
        except CvBridgeError as e:
            self.get_logger().error(f"Depth conversion failed: {e}")
            return

        with self._mtx:
            if not self._detections:
                return
            detection_snapshot = list(self._detections)

        scaled_bboxes = detection_snapshot
        if not hasattr(self, "rgb_w"):
            return

        depth_h, depth_w = cv_depth.shape[:2]

        detectedmsg = DetectedObjectArray()
        detectedmsg.header.stamp = self.get_clock().now().to_msg()
        detectedmsg.header.frame_id = self.global_frame_

        for det in scaled_bboxes:

            xmin, xmax, ymin, ymax = det["bbox"]
            class_name = det["class"]

            cx_pix = int((xmin + xmax) / 2)
            cy_pix = int((ymin + ymax) / 2)

            self.get_logger().info(f"cx_pix{cx_pix}::cypix::{cy_pix}")

            roi = cv_depth[ymin:ymax, xmin:xmax]
            valid_depths = roi[np.isfinite(roi) & (roi > 0)]

            if valid_depths.size == 0:
                self.get_logger().warn(f"BBox[{det}] no valid depth — skipping")
                continue

            depth = float(np.median(valid_depths)) / 1000.0

            fx = self._cam_model.fx()
            fy = self._cam_model.fy()
            ppx = self._cam_model.cx()
            ppy = self._cam_model.cy()

            cx = (cx_pix - ppx) * depth / fx
            cy = (cy_pix - ppy) * depth / fy
            cz = depth

            self.get_logger().info(
                f"BBox[{det}] centroid optical frame: "
                f"x={cx:.3f} y={cy:.3f} z={cz:.3f}"
            )

            pt = PointStamped()
            pt.header.stamp = msg.header.stamp
            pt.header.frame_id = self.depth_optical_frame_
            pt.point.x = cx
            pt.point.y = cy
            pt.point.z = cz

            try:
                if not self.tf_buffer.can_transform(
                        self.global_frame_, self.depth_optical_frame_,
                        msg.header.stamp, timeout=Duration(seconds=0.5)):
                    self.get_logger().warn("TF unavailable")
                    continue

                transform = self.tf_buffer.lookup_transform(
                    self.global_frame_, self.depth_optical_frame_,
                    msg.header.stamp, timeout=Duration(seconds=0.5))

                pt_out = tf2_geometry_msgs.do_transform_point(pt, transform)

            except Exception as e:
                self.get_logger().warn(f"TF transform failed: {e}")
                continue

            self.get_logger().info(
                f"BBox[{det}] in map: "
                f"x={pt_out.point.x:.3f} y={pt_out.point.y:.3f} z={pt_out.point.z:.3f}"
            )

            obj = DetectedObject()
            obj.class_name = class_name
            obj.confidence = float(det["confidence"])
            obj.pose.position.x = pt_out.point.x
            obj.pose.position.y = pt_out.point.y
            obj.pose.position.z = pt_out.point.z
            obj.pose.orientation.w = 1.0

            duplicate = False
            for existing in detectedmsg.objects:
                if existing.class_name != obj.class_name:
                    continue
                dist = math.sqrt(
                    (existing.pose.position.x - obj.pose.position.x) ** 2 +
                    (existing.pose.position.y - obj.pose.position.y) ** 2
                )
                if dist < self.dedup_dist_thresh_:
                    duplicate = True
                    break

            if duplicate:
                continue

            detectedmsg.objects.append(obj)

        if len(detectedmsg.objects) > 0:
            self.get_logger().info(
                f"Publishing {len(detectedmsg.objects)} object pose(s): "
                f"{[o.class_name for o in detectedmsg.objects]}"
            )
            self.detected_object_pub.publish(detectedmsg)

        if self.latest_rgb is not None:
            debug_msg = self._bridge.cv2_to_imgmsg(
                self.latest_rgb, encoding="passthrough")
            debug_msg.header = msg.header
            self._debug_img_pub.publish(debug_msg)



    def _is_duplicate_in_batch(self, existing_objects, obj) -> bool:
        for existing in existing_objects:
            if existing.class_name != obj.class_name:
                continue
            dist = math.sqrt(
                (existing.pose.position.x - obj.pose.position.x) ** 2 +
                (existing.pose.position.y - obj.pose.position.y) ** 2)
            if dist < self.dedup_dist_thresh_:
                return True
        return False
    
    def _pixel_bbox_to_frame(self, bbox, cv_depth, stamp, target_frame,radius_offset:float=0.0):
        
        xmin, xmax, ymin, ymax = bbox
        depth_h,depth_w=cv_depth.shape[:2]
        if self.rgb_w != depth_w or self.rgb_h != depth_h:
            self.get_logger().warn(
            f"RGB/depth resolution mismatch: "
            f"RGB={self.rgb_w}x{self.rgb_h}, "
            f"Depth={depth_w}x{depth_h}"
        )
        sx = depth_w / float(self.rgb_w)
        sy = depth_h / float(self.rgb_h)
        xmin = int(xmin * sx)
        xmax = int(xmax * sx)
        ymin = int(ymin * sy)
        ymax = int(ymax * sy)
        xmin = max(0, min(xmin, depth_w - 1))
        xmax = max(0, min(xmax, depth_w))
        ymin = max(0, min(ymin, depth_h - 1))
        ymax = max(0, min(ymax, depth_h))
        if xmax <= xmin or ymax <= ymin:
            self.get_logger().warn("Invalid depth bbox")
            return None
        
        
        



        cx_pix = int((xmin + xmax) / 2)
        cy_pix = int((ymin + ymax) / 2)
        
        
        roi = cv_depth[ymin:ymax, xmin:xmax]
        valid_depths = roi[np.isfinite(roi) & (roi > 0)]
        if valid_depths.size < DEPTH_ROI_MIN_VALID_PIXELS:
            self.get_logger().warn(f"BBox[{bbox}] not enough valid depth pixels -- skipping")
            return None

        if cv_depth.dtype == np.uint16:
            depth = float(np.median(valid_depths)) / 1000.0
        else:
            depth = float(np.median(valid_depths))

        if depth <= 0.05 or depth > 10.0:
            self.get_logger().warn(
                f"Invalid depth value: {depth:.3f} m"
            )
            return None
        self.get_logger().info(
        f"Ball pixel=({cx_pix},{cy_pix}), "
        f"depth={depth:.3f} m, "
        f"valid_pixels={valid_depths.size}"
    )
        fx = self._cam_model.fx()
        fy = self._cam_model.fy()
        ppx = self._cam_model.cx()
        ppy = self._cam_model.cy()
        if fx <= 0 or fy <= 0:
            self.get_logger().error(
                f"Invalid camera intrinsics: "
                f"fx={fx}, fy={fy}"
            )
            return None

        x = (cx_pix - ppx) * depth / fx
        y = (cy_pix - ppy) * depth / fy
        z = depth
        if radius_offset:
            ray = np.array([x, y, z], dtype=float)
            n = np.linalg.norm(ray)
            if n > 1e-6:
                x, y, z = ray + (ray/n) * radius_offset
        
       

        self.get_logger().info(
            f"3D optical point: "
            f"x={x:.3f}, "
            f"y={y:.3f}, "
            f"z={z:.3f}"
        )

        pt = PointStamped()
        pt.header.stamp = stamp
        pt.header.frame_id = self.depth_optical_frame_
        pt.point.x = x
        pt.point.y = y
        pt.point.z = z

        try:
            if not self.tf_buffer.can_transform(
                    target_frame, self.depth_optical_frame_, stamp, timeout=Duration(seconds=0.5)):
                self.get_logger().warn("TF unavailable")
                return None
            transform = self.tf_buffer.lookup_transform(
                target_frame, self.depth_optical_frame_, stamp, timeout=Duration(seconds=0.5))
            
            pt_out = tf2_geometry_msgs.do_transform_point(
            pt,
            transform
        )

        except Exception as e:
            self.get_logger().warn(f"TF transform failed: {e}")
            return None
        self.get_logger().info(
        f"3D {target_frame} point: "
        f"x={pt_out.point.x:.3f}, "
        f"y={pt_out.point.y:.3f}, "
        f"z={pt_out.point.z:.3f}"
    )

        return pt_out

    def golf_ball_pose_callback(self, msg: DetectedObjectArray):
        if self.robot_busy or not msg.objects:
            return

        t = self.get_robot_pose()
        if t is None:
            return

        valid_objects = [obj.pose for obj in msg.objects if not self.is_object_visited(obj.pose)]
        if not valid_objects:
            return

        self.scanning = False
        self.full_rotation_done = False
        self.stop_robot()

        for pose in valid_objects:
            self.add_object(pose)

    def get_robot_pose(self):
        try:
            return self.tf_buffer.lookup_transform(
                self.map_frame, self.robot_base_frame, rclpy.time.Time())
        except TransformException as ex:
            self.get_logger().warn(
                f"Could not transform {self.map_frame} to {self.robot_base_frame}: {ex}")
            return None

    def is_object_visited(self, pose) -> bool:
        for vx, vy in self.visited_objects:
            if math.sqrt((pose.position.x - vx) ** 2 + (pose.position.y - vy) ** 2) < 1.0:
                return True
        return False

    def add_object(self, pose):
        """Add a newly-seen object to memory (dedup by distance)."""
        for obj in self.detected_objects:
            dist = math.sqrt((obj["x"] - pose.position.x) ** 2 + (obj["y"] - pose.position.y) ** 2)
            if dist < 0.5:
                return  
        self.detected_objects.append({
            "x": pose.position.x,
            "y": pose.position.y,
            "visited": False,
        })

    def stop_robot(self):
        self.cmd_vel_pub.publish(Twist())

    stop_base = stop_robot  

    def plan_next_goal(self):
        if self.robot_busy:
            return
        candidates = [obj for obj in self.detected_objects if not obj["visited"]]
        if not candidates:
            return
        t = self.get_robot_pose()
        if t is None:
            return
        robot_x = t.transform.translation.x
        robot_y = t.transform.translation.y
        nearest = min(candidates, key=lambda o: math.hypot(o["x"] - robot_x, o["y"] - robot_y))

        pose = Pose()
        pose.position.x = nearest["x"]
        pose.position.y = nearest["y"]
        self.current_target = nearest
        self.robot_busy = True
        threading.Thread(target=self.send_goal, args=(pose,), daemon=True).start()

    def send_goal(self, pose, keep_orientation=False, add_offset=True) -> bool:
        """Drive to `pose` via Nav2. Returns True on success."""
        if self.currently_navigating:
            return False

        self.stop_robot()
        goal_pose = PoseStamped()
        goal_pose.header.frame_id = self.map_frame
        goal_pose.header.stamp = self.navigator.get_clock().now().to_msg()

        t = self.get_robot_pose()
        if t is None:
            return False
        robot_x = t.transform.translation.x
        robot_y = t.transform.translation.y

        theta = math.atan2(pose.position.y - robot_y, pose.position.x - robot_x)

        if add_offset:
            offset_x = APPROACH_STANDOFF_DIST * math.cos(theta)
            offset_y = APPROACH_STANDOFF_DIST * math.sin(theta)
        else:
            offset_x = offset_y = 0.0

        if keep_orientation:
            w, z = pose.orientation.w, pose.orientation.z
        else:
            w, _, _, z = euler2quat(0, 0, theta)

        goal_pose.pose.position.x = pose.position.x - offset_x
        goal_pose.pose.position.y = pose.position.y - offset_y
        goal_pose.pose.position.z = 0.0
        goal_pose.pose.orientation.w = w
        goal_pose.pose.orientation.z = z

        self.get_logger().info(
            f"Sending nav goal -> x={goal_pose.pose.position.x:.2f}, y={goal_pose.pose.position.y:.2f}")

        success = False
        try:
            self.currently_navigating = True
            self.stop_robot()
            sleep(0.5)

            self.navigator.goToPose(goal_pose)
            while not self.navigator.isTaskComplete():
                sleep(0.1)

            result = self.navigator.getResult()
            if result == TaskResult.SUCCEEDED:
                self.get_logger().info("Nav goal succeeded.")
                success = True
                if self.current_target is not None:
                    self.current_target["visited"] = True
                    self.visited_objects.append((self.current_target["x"], self.current_target["y"]))
            elif result == TaskResult.CANCELED:
                self.get_logger().warn("Nav goal canceled.")
            elif result == TaskResult.FAILED:
                self.get_logger().error("Nav goal failed.")
        finally:
            self.currently_navigating = False
            self.robot_busy = False

        return success

    
    def run_mission(self):
        while rclpy.ok() and not self.camera_info_received:
            time.sleep(0.2)

        while rclpy.ok():
            try:
               
                self.state = MissionState.DETECT_BALL
                if not self._run_phase("Detect ball (in front, no search)", self._phase_detect_ball):
                    self.get_logger().warn("Ball not confirmed in front -- retrying")
                    continue

                self.state = MissionState.NAVIGATE_TO_BALL
                if not self._run_phase("Approach ball (visual servo)", self._phase_navigate_to_ball):
                    self.get_logger().warn("Lost ball while approaching -- retrying pick cycle")
                    continue
                if not self._run_phase("Fine reposition for arm reach", self.reposition_for_reach):
                    self.get_logger().warn("Could not reach arm reach band -- retrying pick cycle")
                    continue

                self.state = MissionState.PICK
                if not self._run_phase("Pick ball", self._phase_pick):
                    self.get_logger().error("Pick failed -- retrying pick cycle")
                    continue

                
                self.state = MissionState.DETECT_BOX
                if not self._run_phase("Search for box", self._phase_detect_box):
                    self.get_logger().warn("Box not found -- retrying search")
                    continue

                self.state = MissionState.NAVIGATE_TO_BOX
                if not self._run_phase("Navigate to box", self._phase_navigate_to_box):
                    self.get_logger().warn("Nav to box failed -- retrying search")
                    continue

                self.state = MissionState.PLACE
                if not self._run_phase("Place ball", self._phase_place):
                    self.get_logger().error("Place failed -- retrying place cycle")
                    continue

                self.get_logger().info("Mission cycle complete. Restarting for next ball...")

            except Exception as e:
                self.get_logger().error(f"Mission step failed: {e}")
                self.stop_base()
                time.sleep(2.0)

    def _run_phase(self, label: str, phase_fn):
        
        self.get_logger().info(f" {label}")
        result_box = {}

        def _runner():
            result_box["ok"] = phase_fn()

        thread = threading.Thread(target=_runner, daemon=True)
        thread.start()
        thread.join()

        ok = bool(result_box.get("ok"))
        self.get_logger().info(f"--- Phase end: {label} -> {'OK' if ok else 'FAILED'} ---")
        return ok

    
    def _phase_detect_ball(self) -> bool:
        deadline = time.monotonic() + DETECT_BALL_CONFIRM_TIMEOUT
        while time.monotonic() < deadline and rclpy.ok():
            with self.rgb_lock:
                frame = None if self.latest_rgb is None else self.latest_rgb.copy()
            if frame is not None:
                bbox = detect_rectangles_yolo(self.model,frame)
                if bbox:
                    self.last_ball_bbox = bbox[0]
                    self.get_logger().info(f"Ball confirmed in front at bbox={bbox[0]}")
                    return True
            time.sleep(DETECT_BALL_CONFIRM_PERIOD)
        return False

    
    def _phase_navigate_to_ball(self) -> bool:
        self._last_twist = None
        while rclpy.ok():
            reached = self.track_ball_step()
            if reached:
                return True
            if self.last_ball_bbox is None:
                pass
            time.sleep(TRACK_LOOP_PERIOD_SEC)
           
            if self._ball_lost_for(seconds=5.0):
                self.stop_base()
                return False
        return False

    def _ball_lost_for(self, seconds: float) -> bool:
        if self.last_ball_seen_time is None:
            return False

        return (
            time.monotonic() - self.last_ball_seen_time
        ) > seconds
    

    def track_ball_step(self) -> bool:
        with self._mtx:
            dets = list(self._detections)
            det_age = time.monotonic() - self._det_time
            frame = None if self.latest_rgb is None else self.latest_rgb
            img_w = None if frame is None else frame.shape[1]

        if img_w is None:
            return False

        twist = Twist()

        # no ball, or detection too old (>0.5 s)
        if not dets or det_age > 0.5:
            self.get_logger().warn("Ball not visible, rotating to search")
            twist.angular.z = SEARCH_SPIN_SPEED
            self._last_twist = twist
            self.cmd_vel_pub.publish(twist)
            return False

        # pick best detection (highest confidence). Add class filter if needed:
        # dets = [d for d in dets if d["class"] == "ball"]
        det = max(dets, key=lambda d: d["confidence"])
        x1, x2, y1, y2 = det["bbox"]       # order is x1, x2, y1, y2

        self.last_ball_seen_time = time.monotonic()
        self.last_ball_bbox = (x1, x2, y1, y2)

        cx = (x1 + x2) / 2.0
        area = (x2 - x1) * (y2 - y1)
        error_x = cx - img_w / 2.0

        angular = -TRACK_ANGULAR_GAIN * error_x
        twist.angular.z = max(-TRACK_MAX_ANGULAR, min(TRACK_MAX_ANGULAR, angular))

        centered = abs(error_x) < CENTER_TOLERANCE_PX
        close_enough = area >= TARGET_AREA

        if centered and close_enough:
            twist = Twist()                 # full stop
            self._last_twist = twist
            self.cmd_vel_pub.publish(twist)
            self.get_logger().info(f"Ball reached: cx={cx:.0f}, area={area:.0f}")
            return True

        twist.linear.x = TRACK_LINEAR_SPEED if centered else 0.0
        self._last_twist = twist
        self.cmd_vel_pub.publish(twist)
        self.get_logger().info(
            f"Tracking: cx={cx:.0f}, err={error_x:.0f}, area={area:.0f} "
            f"(target {TARGET_AREA}, centered={centered}, conf={det['confidence']:.2f})")
        return False

    
    def _phase_pick(self) -> bool:
        if self.last_ball_bbox is None:
            self.get_logger().error("No ball bbox available for pick")
            return False
        pt_base = self.get_pose_in_base(self.last_ball_bbox,radius_offset=BALL_RADIUS_M)
        if pt_base is None:
            self.get_logger().error("Could not localize ball in base frame")
            return False
        return self.run_pick_sequence(pt_base)

   
    def _phase_detect_box(self) -> bool:
        bbox = self.search_for(detect_rectangles_yolo, timeout=SEARCH_SPIN_TIMEOUT)
        if bbox is None:
            return False
        self.last_box_bbox = bbox
        return True

    def search_for(self, detector_fn, timeout: float = SEARCH_SPIN_TIMEOUT):
        """Spin in place scanning for an object with `detector_fn`. Returns
        the bbox [xmin, xmax, ymin, ymax] or None on timeout."""
        deadline = time.monotonic() + timeout
        twist = Twist()
        while time.monotonic() < deadline and rclpy.ok():
            with self.rgb_lock:
                frame = None if self.latest_rgb is None else self.latest_rgb.copy()
            if frame is not None:
                bboxes = detector_fn(frame)
                if bboxes:
                    self.stop_base()
                    return bboxes[0]

            twist.angular.z = SEARCH_SPIN_SPEED
            self.cmd_vel_pub.publish(twist)
            time.sleep(SEARCH_SPIN_PERIOD)

        self.stop_base()
        return None

   
    def _phase_navigate_to_box(self) -> bool:
        if self.last_box_bbox is None:
            return False
        obj_map_pose = self.get_map_pose_for_bbox(self.last_box_bbox)
        if obj_map_pose is None:
            self.get_logger().error("Could not localize box in map frame")
            return False
        approach = self.compute_approach_pose(obj_map_pose)
        return self.send_nav_goal(approach)

    def get_map_pose_for_bbox(self, bbox):
        with self.rgb_lock:
            frame = None if self.latest_rgb is None else self.latest_rgb.copy()
        if frame is None or self.latest_rgb_msg is None:
            return None
        
        cv_depth = self._latest_depth_for_bbox()
        if cv_depth is None:
            return None
        pt_out = self._pixel_bbox_to_frame(bbox, cv_depth, self.latest_rgb_msg.header.stamp, self.global_frame_)
        if pt_out is None:
            return None
        pose = Pose()
        pose.position.x = pt_out.point.x
        pose.position.y = pt_out.point.y
        pose.position.z = pt_out.point.z
        pose.orientation.w = 1.0
        return pose

    def _latest_depth_for_bbox(self):
       
        return getattr(self, "_latest_depth_cv", None)

    def compute_approach_pose(self, obj_map_pose: Pose) -> Pose:
        """Offset a standoff distance in front of the box, facing it, so the
        arm has room to place. Uses the robot's current heading toward the
        box to decide the approach direction."""
        t = self.get_robot_pose()
        approach = Pose()
        if t is None:
            approach.position = obj_map_pose.position
            return approach

        robot_x = t.transform.translation.x
        robot_y = t.transform.translation.y
        theta = math.atan2(obj_map_pose.position.y - robot_y, obj_map_pose.position.x - robot_x)

        approach.position.x = obj_map_pose.position.x - APPROACH_STANDOFF_DIST * math.cos(theta)
        approach.position.y = obj_map_pose.position.y - APPROACH_STANDOFF_DIST * math.sin(theta)
        approach.position.z = 0.0
        w, _, _, z = euler2quat(0, 0, theta)
        approach.orientation.w = w
        approach.orientation.z = z
        return approach
    def _wait_for_future(self, future, timeout_sec: float, poll_period: float = 0.01) -> bool:
        deadline = time.monotonic() + timeout_sec
        while rclpy.ok():
            if future.done():
                return True
            if time.monotonic() >= deadline:
                return False
            time.sleep(poll_period)
        return future.done()
    def send_gripper_command(self, position: float, max_effort: float = 50.0, timeout_sec: float = 5.0) -> bool:
        if not self.gripper.server_is_ready():
            self.get_logger().error("gripper action server is not ready")
            return False

        goal_msg = GripperCommand.Goal()
        goal_msg.command.position = float(position)
        goal_msg.command.max_effort = float(max_effort)

        self.get_logger().info(
            f"Sending gripper command: "
            f"position={position:.4f}, "
            f"max_effort={max_effort:.2f}"
        )

        send_goal_future = self.gripper.send_goal_async(goal_msg)
        if not self._wait_for_future(send_goal_future, timeout_sec=timeout_sec):
            self.get_logger().error("timed out waiting for gripper goal")
            return False

        goal_handle = send_goal_future.result()
        if goal_handle is None:
            self.get_logger().error("no gripper goal handle")
            return False
        if not goal_handle.accepted:
            self.get_logger().error("gripper goal was rejected")
            return False
        self.get_logger().info("gripper goal was accepted")

        result_future = goal_handle.get_result_async()
        if not self._wait_for_future(result_future, timeout_sec=timeout_sec):
            self.get_logger().error("timed out for gripper result")
            return False

        result_wrapper = result_future.result()
        if result_wrapper is None:
            self.get_logger().error("no result returned from gripper")
            return False

        result = result_wrapper.result
        self.get_logger().info(
            f"Gripper result, "
            f"position={result.position:.4f}, "
            f"effort={result.effort:.4f}, "
            f"stalled={result.stalled}, "
            f"reached_goal={result.reached_goal}"
        )
        time.sleep(0.2)
        if self.joint_state is not None:
            for name, val in zip(self.joint_state.name, self.joint_state.position):
                if 'gripper' in name.lower():
                    self.get_logger().info(f"Real joint_states check: {name}={val:.4f} (target={position:.4f})")
                    if abs(val - position) > 0.005:
                        self.get_logger().error(f"Gripper joint NOT at target! actual={val:.4f} target={position:.4f}")
                        return False

        if result.reached_goal:
            self.get_logger().info("gripper command successfully completed")
            return True
        if result.stalled:
            self.get_logger().warn("gripper stalled")
            return False

        
        self.get_logger().warn("gripper command finished without reaching goal or stalling")
        return False
    
    def send_nav_goal(self, approach_pose: Pose):
        return self.send_goal(approach_pose, keep_orientation=True, add_offset=False)

    
    def _phase_place(self) -> bool:
        self.get_logger().info("Re-detecting box close-up for place...")
        bbox = self.search_for(detect_rectangles_yolo, timeout=5.0)
        if bbox is None:
            self.get_logger().warn("Lost box after nav")
            return False
        pt_base = self.get_pose_in_base(bbox)
        if pt_base is None:
            self.get_logger().error("Could not localize box in base frame")
            return False
        return self.run_place_sequence(pt_base)

    def get_pose_in_base(self, bbox,radius_offset:float=0.0):
        cv_depth = self._latest_depth_for_bbox()
        if cv_depth is None or self.latest_rgb_msg is None:
            return None
        return self._pixel_bbox_to_frame(bbox, cv_depth, self._latest_depth_msg.header.stamp, self.robot_base_frame_,radius_offset=radius_offset)

    def build_pose(self, pt_base: PointStamped) -> PoseStamped:
        pose = PoseStamped()
        pose.header.frame_id = pt_base.header.frame_id
        pose.header.stamp = self.get_clock().now().to_msg()
        pose.pose.position.x = pt_base.point.x
        pose.pose.position.y = pt_base.point.y
        pose.pose.position.z = pt_base.point.z
        pose.pose.orientation.w = 0.0
        pose.pose.orientation.x = 1.0
        pose.pose.orientation.y = 0.0
        pose.pose.orientation.z = 0.0
        return pose
    def run_pick_sequence(self,pt_base:PointStamped)->bool:
        grasp_pose=self.build_pose(pt_base)
        pre_grasp=PoseStamped()
        pre_grasp.header=grasp_pose.header
        pre_grasp.pose.position.x = grasp_pose.pose.position.x
        pre_grasp.pose.position.y = grasp_pose.pose.position.y
        pre_grasp.pose.position.z = grasp_pose.pose.position.z + GRASP_Z_OFFSET_PREGRASP
        pre_grasp.pose.orientation = grasp_pose.pose.orientation
        self.get_logger().info("opening a gripper")
        if not self.open_gripper():
              self.get_logger().info("failed to opening a gripper") 
              return False
        self.get_logger().info("moving to pregrasp")
     
        if not self.move_to_pose(pre_grasp,cartesian=False):
              self.get_logger().info("failed to reach a pre grasp pose")
              return False
        self.get_logger().info("cartesian decent to grasp pose") 
        self._log_ee_pose("post-pregrasp")
      
        if not self.move_to_pose(grasp_pose,cartesian=False):
            self.get_logger().info("failed to reach a grasp pose") 
            return False
        self.get_logger().info("closing a gripper")
        self._log_ee_pose("post-pregrasp")
        if not self.close_gripper():
              self.get_logger().info("failed to close a gripper")
              return False
        time.sleep(0.3) 
        retreat=PoseStamped()
        retreat.header=grasp_pose.header
        retreat.pose.position.x = grasp_pose.pose.position.x
        retreat.pose.position.y = grasp_pose.pose.position.y
        retreat.pose.position.z = grasp_pose.pose.position.z + GRASP_Z_OFFSET_LIFT
        retreat.pose.orientation = grasp_pose.pose.orientation
        self.get_logger().info("cartesian")
       
        if not self.move_to_pose(retreat,cartesian=False):
            self.get_logger().error("failed to lift object")
            return False
        self.get_logger().info("pick sequence completed")
        self._log_ee_pose("post-pregrasp")
        return True
    def run_place_sequence(self,pt_base:PointStamped)->bool:
        drop_pose=self.build_pose(pt_base)
        drop_pose.pose.position.z=(pt_base.point.z+PLACE_DROP_HEIGHT)
        pre_place=PoseStamped()
        pre_place.header=drop_pose.header
        pre_place.pose.position.x=drop_pose.pose.position.x
        pre_place.pose.position.y=drop_pose.pose.position.y
        pre_place.pose.position.z=drop_pose.pose.position.z + PLACE_Z_OFFSET_PRE
        pre_place.pose.orientation=(drop_pose.pose.orientation)
       
        if not self.move_to_pose(pre_place,cartesian=False):
            self.get_logger().error("failed to reach pre-place pose.")
            return False
        self.get_logger().info("cartesian descent to drop pose")
       
        if not self.move_to_pose(drop_pose,cartesian=False): 
            self.get_logger().error( "Failed to reach drop pose." ) 
            return False
        self.get_logger().info( "STEP 3: Opening gripper to release object..." )
        self._log_ee_pose("post-pregrasp")
        if not self.open_gripper(): 
            self.get_logger().error( "Failed to open gripper." ) 
            return False
        
        time.sleep(0.3)
        self.get_logger().info( "STEP 4: Cartesian retreat..." )
      
        if not self.move_to_pose(pre_place,cartesian=False): 
            self.get_logger().error( "Failed to retreat from place position." ) 
            return False 
        self.get_logger().info( "Place sequence completed successfully." )
        self._log_ee_pose("post-pregrasp")
        return True
    
def main():
    rclpy.init()
    node = PickAndPlaceNode()
    executor = MultiThreadedExecutor()
    executor.add_node(node)

    mission_thread = threading.Thread(target=node.run_mission, daemon=True)
    mission_thread.start()

    try:
        executor.spin()
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    main()