BALL_RADIUS_M = 0.030
MIN_BBOX_AREA = 3500
TARGET_AREA = 15000
TRACK_LINEAR_SPEED = 0.10
TRACK_ANGULAR_GAIN = 0.003
TRACK_MAX_ANGULAR = 0.5
SEARCH_SPIN_SPEED = 0.2
TRACK_LOOP_PERIOD_SEC = 0.1
CENTER_TOLERANCE_PX = 25
EE_LINK = 'end_effector_link'

PLAN_TIMEOUT_SEC = 8.0

PLANNING_GROUP = 'arm'

IK_ORIENTATION_TOLERANCE_CARTESIAN = 0.4

GRASP_Z_OFFSET_PREGRASP = 0.12
GRASP_Z_OFFSET_LIFT = 0.20
PLACE_Z_OFFSET_PRE = 0.15
PLACE_DROP_HEIGHT = 0.08
DEPTH_ROI_MIN_VALID_PIXELS = 5
GRIPPER_OPEN_POSITION = 0.019   # match URDF upper limit exact
GRIPPER_CLOSE_POSITION = 0.010    # within [-0.010, 0.019] range, ok as-is
GRIPPER_MAX_EFFORT = 5.0        # match URDF effort limit, avoid confusion

DETECT_BALL_CONFIRM_TIMEOUT = 3.0    
DETECT_BALL_CONFIRM_PERIOD = 0.1

SEARCH_SPIN_TIMEOUT = 5.0            
SEARCH_SPIN_PERIOD = 0.1

APPROACH_STANDOFF_DIST = 0.5          

ARM_MIN_REACH_RADIUS = 0.15      # tune from your arm reach envelope
ARM_MAX_REACH_RADIUS = 0.26      # tune
ARM_IDEAL_STANDOFF_X = 0.20      # center of good band, tune
ARM_STANDOFF_TOLERANCE = 0.02
REPOSITION_LINEAR_GAIN = 0.5
REPOSITION_MAX_LINEAR = 0.06
REPOSITION_MAX_ATTEMPTS = 6
REPOSITION_SETTLE_SEC = 0.4
class MissionState(Enum):
    DETECT_BALL = auto()
    NAVIGATE_TO_BALL = auto()
    PICK = auto()
    DETECT_BOX = auto()
    NAVIGATE_TO_BOX = auto()
    PLACE = auto()


def detect_rectangles_box_hsv(image: np.ndarray) -> list:
    hsv = cv2.cvtColor(image, cv2.COLOR_BGR2HSV)
    lower_brown = np.array([10, 80, 40])
    upper_brown = np.array([20, 200, 180])
    mask = cv2.inRange(hsv, lower_brown, upper_brown)

    kernel = np.ones((5, 5), np.uint8)
    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)

    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    if not contours:
        return []

    cnt = max(contours, key=cv2.contourArea)
    

    x, y, w, h = cv2.boundingRect(cnt)
    return [[x, x + w, y, y + h]]


def detect_rectangles_ball_hsv(image: np.ndarray) -> list:
    hsv = cv2.cvtColor(image, cv2.COLOR_BGR2HSV)
    lower_yellow = np.array([25, 100, 100])
    upper_yellow = np.array([35, 255, 255])
   

    mask = cv2.inRange(hsv, lower_yellow, upper_yellow) 

    kernel = np.ones((5, 5), np.uint8)
    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)
    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)

    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    if not contours:
        return []

    cnt = max(contours, key=cv2.contourArea)
    

    x, y, w, h = cv2.boundingRect(cnt)
    return [[x, x + w, y, y + h]]


def detect_rectangles_yolo(model, image: np.ndarray):
    results = model(image, conf=0.3, verbose=False)
    detections = []
    for r in results:
        for box in r.boxes:
            conf = float(box.conf[0])
            cls_id = int(box.cls[0])
            class_name = model.names[cls_id]
            x1, y1, x2, y2 = map(int, box.xyxy[0])
            detections.append({
                "class": class_name,
                "confidence": conf,
                "bbox": [x1, x2, y1, y2],
            })
    return detections


class PickAndPlaceNode(Node):

    def __init__(self):
        super().__init__("pick_and_place_node")

        ns = self.get_namespace().strip("/")
        if ns:
            prefix=f"/{ns}"
        else:
            prefix=""
        
        caminfo_topic = "/camera/camera/color/camera_info"
        rgb_topic = "/camera/camera/color/image_raw"
        depth_topic = "/camera/camera/depth/image_rect_raw"
        pose_topic    = "/box_poses"
        self._bridge = CvBridge()
        self.declare_parameter("to_meter", 1.0)
        self.declare_parameter("global_frame", "map")
        self.declare_parameter("robot_base_frame", "base_link")
        self.declare_parameter("min_bbox_area", 5000)
        self.declare_parameter("dedup_dist_thresh", 0.4)
        self.declare_parameter("yolo_model_path",
                                "/home/startrace1/best.pt")
        self._bboxes=[]
        self._det_time = 0.0
        self.to_meter_ = self.get_parameter("to_meter").value
        self.global_frame_ = self.get_parameter("global_frame").value
        self.robot_base_frame_ = self.get_parameter("robot_base_frame").value
        self.min_bbox_area_ = self.get_parameter("min_bbox_area").value
        self.dedup_dist_thresh_ = self.get_parameter("dedup_dist_thresh").value
        cb_group = ReentrantCallbackGroup()
        self.last_ball_seen_time = None
        self.tf_buffer = tf2_ros.Buffer(cache_time=Duration(seconds=10))
        self.tf_listener = tf2_ros.TransformListener(self.tf_buffer, self)
        self.get_logger().info(f"Waiting for CameraInfo on '{caminfo_topic}' ...")
        cam_info_msg = self.wait_for_camera_info(caminfo_topic)
        self._cam_model = image_geometry.PinholeCameraModel()
        self._cam_model.fromCameraInfo(cam_info_msg)
        
        self.depth_optical_frame_ = "camera_depth_optical_frame" 
        self.camera_info_received = True
        self.get_logger().info(
    f"Camera optical frame: {self.depth_optical_frame_}"
)
        tf_ready = False
        for _ in range(20):

            if self.tf_buffer.can_transform(
                    self.global_frame_,
                    self.depth_optical_frame_,
                    rclpy.time.Time(),
                    timeout=Duration(seconds=0.5)):

                tf_ready = True
                break

            self.get_logger().warn("Waiting for TF tree...")
            rclpy.spin_once(self, timeout_sec=0.2)

        if tf_ready:

            self.get_logger().info(
                f"TF chain OK ✓ '{self.depth_optical_frame_}'→'{self.global_frame_}'")

        else:

            self.get_logger().error(
                f"TF chain STILL MISSING: "
                f"'{self.depth_optical_frame_}'→'{self.global_frame_}'"
            )
        tf_ready = False
        for _ in range(20):

            if self.tf_buffer.can_transform(
                    self.robot_base_frame_,
                    self.depth_optical_frame_,
                    rclpy.time.Time(),
                    timeout=Duration(seconds=0.5)):

                tf_ready = True
                break

            self.get_logger().warn("Waiting for TF tree...")
            rclpy.spin_once(self, timeout_sec=0.2)

        if tf_ready:

            self.get_logger().info(
                f"TF chain OK ✓ '{self.depth_optical_frame_}'→'{self.robot_base_frame_}'")

        else:

            self.get_logger().error(
                f"TF chain STILL MISSING: "
                f"'{self.depth_optical_frame_}'→'{self.robot_base_frame_}'"
            )
        
        self.joint_state = None

        self.joint_state_sub = self.create_subscription(
            JointState,
            "/joint_states",
            self._joint_state_callback,
            10,
            callback_group=cb_group,
        )

        self.compute_ik_client = self.create_client(
            GetPositionIK,
            "/compute_ik",
            callback_group=cb_group,
        )

        self.plan_client = self.create_client(
            GetMotionPlan,
            "/plan_kinematic_path",
            callback_group=cb_group,
        )

        self.execute_client = ActionClient(
            self,
            ExecuteTrajectory,
            "/execute_trajectory",
            callback_group=cb_group,
        )

        self.move_group_client = ActionClient(
            self,
            MoveGroup,
            "/move_action",
            callback_group=cb_group,
        )

        self.get_logger().info("Waiting for MoveIt interfaces...")

        self.compute_ik_client.wait_for_service(timeout_sec=5.0)
        self.plan_client.wait_for_service(timeout_sec=5.0)
        self.execute_client.wait_for_server(timeout_sec=5.0)
        self.move_group_client.wait_for_server(timeout_sec=5.0)

        self.get_logger().info("MoveIt interfaces ready.")
        self.gripper = ActionClient(
    self,
    GripperCommand,
    "/gripper_controller/gripper_cmd",
)
        self.get_logger().info("Waiting for gripper action server...")

        if not self.gripper.wait_for_server(timeout_sec=5.0):
            self.get_logger().error(
                "Gripper action server not available: "
                "/gripper_controller/gripper_cmd"
            )
        else:
            self.get_logger().info("Gripper action server ready.")
        self.bridge = CvBridge()
        self._detections_lock = threading.Lock()
        self._detections = []
        self.latest_rgb = None          
        self.latest_rgb_msg = None      
        self.rgb_lock = threading.Lock()
        self.rgb_h = None
        self.rgb_w = None
        self.last_ball_bbox = None
        self.last_box_bbox = None
        self._last_twist = None
        self._latest_depth_cv=None
        self._latest_depth_msg=None
        self._mtx    = threading.Lock()
       
       

        
        model_path = self.get_parameter("yolo_model_path").value
        self.model = YOLO(model_path)
        self.model.to("cpu")   
        self.get_logger().info(f"YOLO path={model_path} names={self.model.names}")

        
        self._cbg_rgb = MutuallyExclusiveCallbackGroup()
        self._cbg_depth = MutuallyExclusiveCallbackGroup()
        self._cbg_planner = MutuallyExclusiveCallbackGroup()

        self._rgb_sub = self.create_subscription(
            Image, rgb_topic, self._rgb_callback, 10, callback_group=self._cbg_rgb)
        self._depth_sub = self.create_subscription(
            Image, depth_topic, self._depth_img_callback, 10, callback_group=self._cbg_depth)
        self.golf_bal_pose_sub = self.create_subscription(
            DetectedObjectArray, "planner_object_pose", self.golf_ball_pose_callback, 1,
            callback_group=self._cbg_planner)

        self._debug_img_pub = self.create_publisher(Image, "/pick_place/debug_image", 10)
        self.detected_object_pub = self.create_publisher(DetectedObjectArray, "/detected_objects", 10)
        self.cmd_vel_pub = self.create_publisher(Twist, "/diff_drive_controller/cmd_vel", 10)
        self._pose_pub = self.create_publisher(PoseArray, pose_topic, 10)
        
        self.navigator = BasicNavigator()
        self.map_frame = self.global_frame_
        self.robot_base_frame = self.robot_base_frame_
        self.currently_navigating = False
        self.current_target = None
        self.robot_busy = False
        self.visited_objects = []
        self.detected_objects = []
        self.scanning = False
        self.full_rotation_done = False

                            
     

        self.state = MissionState.DETECT_BALL

        self.get_logger().info("Pick-and-place node initialized.")
    def _get_current_robot_state(self):
        if self.joint_state is None:
            self.get_logger().error("No /manipulator/joint_states received")
            return None

        robot_state = RobotState()
        robot_state.joint_state = self.joint_state

        return robot_state
    def reposition_for_reach(self) -> bool:
        """Creep base forward/back using actual arm-frame ball position
        (not image area) until ball sits inside arm's kinematic reach band."""
        for attempt in range(REPOSITION_MAX_ATTEMPTS):
            if self.last_ball_bbox is None:
                self.get_logger().warn("No ball bbox during reposition")
                return False

            pt_base = self.get_pose_in_base(self.last_ball_bbox, radius_offset=BALL_RADIUS_M)
            if pt_base is None:
                self.get_logger().warn("Could not localize ball during reposition")
                return False

            x = pt_base.point.x
            y = pt_base.point.y
            radius = math.hypot(x, y)

            self.get_logger().info(
                f"Reposition[{attempt}]: x={x:.3f} y={y:.3f} radius={radius:.3f} "
                f"(band {ARM_MIN_REACH_RADIUS:.2f}-{ARM_MAX_REACH_RADIUS:.2f})"
            )

            if ARM_MIN_REACH_RADIUS <= radius <= ARM_MAX_REACH_RADIUS:
                self.stop_base()
                self.get_logger().info("Ball inside arm reach band")
                return True

            err = x - ARM_IDEAL_STANDOFF_X
            twist = Twist()
            twist.linear.x = max(-REPOSITION_MAX_LINEAR,
                                min(REPOSITION_MAX_LINEAR, REPOSITION_LINEAR_GAIN * err))
            self.cmd_vel_pub.publish(twist)
            time.sleep(REPOSITION_SETTLE_SEC)
            self.stop_base()
            time.sleep(0.3)   # let camera/depth settle after stop

        self.stop_base()
        self.get_logger().warn("Reposition attempts exhausted, ball still out of reach band")
        return False
    def compute_ik(self, pose_stamped,timeout_sec:float=5.0):
        if not self.compute_ik_client.wait_for_service(timeout_sec=2.0):
            self.get_logger().error(
                "IK service unavailable: /manipulator/compute_ik"
            )
            return None

        current_state = self._get_current_robot_state()

        if current_state is None:
            return None

        request = GetPositionIK.Request()

        request.ik_request.group_name = PLANNING_GROUP
        request.ik_request.robot_state = current_state
        request.ik_request.pose_stamped = pose_stamped
        request.ik_request.ik_link_name = EE_LINK

        request.ik_request.timeout.sec = 1
        request.ik_request.timeout.nanosec = 500_000_000

        self.get_logger().info(
            f"Requesting IK: group={PLANNING_GROUP}, "
            f"link={EE_LINK}, "
            f"frame={pose_stamped.header.frame_id}"
        )
        
        future = self.compute_ik_client.call_async(request)
        if not self._wait_for_future(future, timeout_sec=timeout_sec):
            self.get_logger().error("timed out waiting for compute ik")
            return False
        

        if not future.done():
            self.get_logger().error("IK request timed out")
            return None

        try:
            response = future.result()
        except Exception as e:
            self.get_logger().error(f"IK service call failed: {e}")
            return None

        if response is None:
            self.get_logger().error("IK returned no response")
            return None

        if response.error_code.val != response.error_code.SUCCESS:
            self.get_logger().error(
                f"IK failed, error code={response.error_code.val}"
            )
            return None

        self.get_logger().info("IK solution found")

        return response.solution
    def execute_trajectory(self, trajectory,timeout_sec:float=5.0) -> bool:

        if trajectory is None:
            self.get_logger().error("No trajectory to execute")
            return False

        goal_msg = ExecuteTrajectory.Goal()
        goal_msg.trajectory = trajectory

        self.get_logger().info(
            "Sending trajectory to MoveIt ExecuteTrajectory action..."
        )

        send_future = self.execute_client.send_goal_async(goal_msg)

        if not self._wait_for_future(send_future, timeout_sec=timeout_sec):
            self.get_logger().error("timed out waiting for compute ik")
            return False

        if not send_future.done():
            self.get_logger().error(
                "Timed out waiting for trajectory goal response"
            )
            return False

        goal_handle = send_future.result()

        if goal_handle is None:
            self.get_logger().error(
                "MoveIt returned no goal handle"
            )
            return False

        if not goal_handle.accepted:
            self.get_logger().error(
                "MoveIt rejected trajectory execution"
            )
            return False

        self.get_logger().info(
            "Trajectory execution goal accepted"
        )

        result_future = goal_handle.get_result_async()

        if not self._wait_for_future(result_future, timeout_sec=timeout_sec):
            self.get_logger().error("timed out waiting for compute ik")
            return False
        

        if not result_future.done():
            self.get_logger().error(
                "Timed out waiting for trajectory execution result"
            )
            return False

        result_wrapper = result_future.result()

        if result_wrapper is None:
            self.get_logger().error(
                "No trajectory execution result received"
            )
            return False

        result = result_wrapper.result

        if result.error_code.val != result.error_code.SUCCESS:
            self.get_logger().error(
                f"MoveIt trajectory execution failed: "
                f"error_code={result.error_code.val}"
            )
            return False

        self.get_logger().info(
            "MoveIt trajectory execution successful"
        )

        return True
    def _log_ee_pose(self, label: str):
        try:
            t = self.tf_buffer.lookup_transform(
                self.robot_base_frame_, EE_LINK, rclpy.time.Time(),
                timeout=Duration(seconds=1.0))
            p = t.transform.translation
            self.get_logger().info(
                f"[{label}] EE actual pose in base: x={p.x:.3f} y={p.y:.3f} z={p.z:.3f}")
        except Exception as e:
            self.get_logger().warn(f"[{label}] EE pose lookup fail: {e}")
    def plan_to_pose(self, pose_stamped,timeout_sec:float=5.0):
        ik_solution = self.compute_ik(pose_stamped)

        if ik_solution is None:
            self.get_logger().error("Cannot plan: IK failed")
            return None

        request = GetMotionPlan.Request()

        motion_request = request.motion_plan_request

        motion_request.group_name = PLANNING_GROUP

        motion_request.start_state = self._get_current_robot_state()

        if motion_request.start_state is None:
            return None

        # Goal constraints from IK solution
        goal_constraints = Constraints()

        joint_names = ik_solution.joint_state.name
        joint_positions = ik_solution.joint_state.position

        for name, position in zip(joint_names, joint_positions):

            # Only constrain joints belonging to the arm.
            if name not in (
                "joint1",
                "joint2",
                "joint3",
                "joint4",
            ):
                continue

            jc = JointConstraint()

            jc.joint_name = name
            jc.position = position

            jc.tolerance_above = 0.01
            jc.tolerance_below = 0.01
            jc.weight = 1.0

            goal_constraints.joint_constraints.append(jc)

        motion_request.goal_constraints.append(goal_constraints)

        # Use the default planner configured by MoveIt.
        motion_request.num_planning_attempts = 5
        motion_request.allowed_planning_time = PLAN_TIMEOUT_SEC
        motion_request.max_velocity_scaling_factor = 0.3
        motion_request.max_acceleration_scaling_factor = 0.3

        self.get_logger().info(
            f"Planning with MoveIt group '{PLANNING_GROUP}'"
        )

        future = self.plan_client.call_async(request)

        if not self._wait_for_future(future, timeout_sec=timeout_sec):
            self.get_logger().error("timed out waiting for compute ik")
            return False

       

        try:
            response = future.result()
        except Exception as e:
            self.get_logger().error(
                f"Motion planning service failed: {e}"
            )
            return None
        if response is None:
            self.get_logger().error("Motion planning returned no response")
            return None
        plan_response = response.motion_plan_response

        if plan_response.error_code.val != plan_response.error_code.SUCCESS:
            self.get_logger().error(
                f"Motion planning failed, "
                f"error code={plan_response.error_code.val}"
            )
            return None

        trajectory = plan_response.trajectory

        if len(trajectory.joint_trajectory.points) == 0:
            self.get_logger().error(
                "MoveIt returned an empty trajectory"
            )
            return None

        self.get_logger().info(
            f"Planning successful: "
            f"{len(trajectory.joint_trajectory.points)} trajectory points"
        )

        return trajectory
    def move_to_pose(
            self,
            pose_stamped: PoseStamped,
            cartesian: bool = False
        ) -> bool:

        self.get_logger().info(
            f"Planning to pose: "
            f"x={pose_stamped.pose.position.x:.3f}, "
            f"y={pose_stamped.pose.position.y:.3f}, "
            f"z={pose_stamped.pose.position.z:.3f}"
        )

        trajectory = self.plan_to_pose(pose_stamped)

        if trajectory is None:
            self.get_logger().error(
                "MoveIt failed to generate a trajectory"
            )
            return False

        return self.execute_trajectory(trajectory)

    def wait_for_camera_info(self, topic: str) -> CameraInfo:
        event = threading.Event()
        received = {}

        def _cb(msg):
            received["msg"] = msg
            event.set()

        sub = self.create_subscription(CameraInfo, topic, _cb, 1)
        tmp_executor = rclpy.executors.SingleThreadedExecutor()
        tmp_executor.add_node(self)

        while rclpy.ok() and not event.is_set():
            tmp_executor.spin_once(timeout_sec=0.1)

        tmp_executor.remove_node(self)
        tmp_executor.shutdown()
        self.destroy_subscription(sub)

        if "msg" not in received:
            raise RuntimeError("CameraInfo never received")
        self.get_logger().info("CameraInfo received successfully.")
        return received["msg"]
    def _joint_state_callback(self, msg: JointState):
        self.joint_state = msg
